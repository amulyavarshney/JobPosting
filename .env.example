# JobPosting — production-ready defaults
# Copy to .env and adjust.

APP_NAME=JobPosting
APP_VERSION=2.0.0
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./jobposting.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/jobposting

# Server
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*

# Auth (recommended in production)
# API_KEY=change-me
# REQUIRE_API_KEY=true

# Scraper HTTP
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_REDIRECTS=5
ALLOW_PRIVATE_NETWORKS=false
SCRAPE_DELAY_SECONDS=0.25

# Scheduler
ENABLE_SCHEDULER=true
SCHEDULER_TICK_SECONDS=60
ARCHIVE_MISSING_JOBS=true

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SCRAPE_RATE_LIMIT_REQUESTS=10
SCRAPE_RATE_LIMIT_WINDOW_SECONDS=60

# Docs / logging / SPA
# ENABLE_DOCS=true
LOG_LEVEL=INFO
LOG_JSON=false
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist

# Optional LLM (not required — use subscriptions)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
